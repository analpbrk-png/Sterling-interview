# Copy to .env.local for development. In production set these in your host's dashboard.

# --- Supabase (Project settings -> API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (server only) -----------------------------------------------------------
# anthropic | none. With no key (or "none"), interviews use approved bank questions
# only and students are told so; CV extraction falls back to basic section detection.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# --- Branding (public) ------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=AI Interview Prep
NEXT_PUBLIC_BRAND_SHORT_NAME=Interview Prep
NEXT_PUBLIC_BRAND_TAGLINE=Practise your study-abroad credibility interview
NEXT_PUBLIC_BRAND_ACCENT=#0f8f86
# Optional: absolute or /public paths
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_FAVICON_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
