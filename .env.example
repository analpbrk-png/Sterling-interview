# Copy to .env.local for local development. On GitHub, set the NEXT_PUBLIC_*
# values as repository VARIABLES (Settings > Secrets and variables > Actions).

# --- Supabase (Project settings -> API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public by design. Row level security protects every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for local helper scripts (scripts/*.mjs). Never put it in GitHub variables
# or the site build. The site itself never uses it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Base path ----------------------------------------------------------------
# GitHub Actions sets this automatically (e.g. /Sterling-interview).
NEXT_PUBLIC_BASE_PATH=

# --- Branding (public) ----------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="AI Interview Prep"
NEXT_PUBLIC_BRAND_SHORT_NAME="Interview Prep"
NEXT_PUBLIC_BRAND_TAGLINE="Practise your study-abroad credibility interview"
NEXT_PUBLIC_BRAND_ACCENT=#0f8f86
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_FAVICON_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- AI ---------------------------------------------------------------------------
# The AI key is NOT an app variable. Store it as a Supabase Edge Function secret:
#   supabase secrets set --project-ref <ref> ANTHROPIC_API_KEY=sk-ant-...
